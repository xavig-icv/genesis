# Captures dels mons (8 MB cadascuna). Es poden regenerar: amb el mateix codi, la mateixa
# llavor i els mateixos paràmetres, la simulació fa exactament la mateixa història.
*.bin
# ...excepte els retalls petits de mons amb vida que fan servir les proves (64 KB cadascun)
!test/fixtures/*.bin

# Fitxers del sistema i de l'editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
node_modules/

# Còpia local de les captures clau (vegeu docs/captures.md)
arxiu-captures/

# Dades internes de la instal·lació: adreces, claus i camins locals (vegeu CLAUDE.md)
CLAUDE.local.md
eines/local.env

# Les dades generades del lloc web (eines/web-dades.mjs): es tornen a fer amb la fitxa de cada món i les captures
web/dades/*/mon.json
web/dades/*/mapes.z
web/dades/*/codi/
web/dades/*/sols/
web/dades/prova/
